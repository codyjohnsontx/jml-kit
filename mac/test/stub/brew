#!/bin/bash
# Fake brew for mac/test/stubbed.sh. Its state lives in $STUB_STATE:
#   installed      one "tap|brew|cask <name> <version>" line per installed entry
#   broken         names whose install fails for some other reason
# Casks put their apps in $JML_APPDIR, where <app>/version holds the app's version. An app
# there that brew did not install is adopted the way Homebrew 6 brew bundle does: silently
# when its version matches, and as a failure when it does not.
# $STUB_BREW_PREFIX is what `brew --prefix` prints.

set -euo pipefail

state=${STUB_STATE:?}
appdir=${JML_APPDIR:?}
version=1.0
touch "$state/installed" "$state/broken"

# The app a cask installs, if any.
cask_app() {
  case "$1" in
    docker-desktop) echo Docker.app ;;
    figma) echo Figma.app ;;
    imageoptim) echo ImageOptim.app ;;
    rectangle) echo Rectangle.app ;;
    slack) echo Slack.app ;;
    visual-studio-code) echo "Visual Studio Code.app" ;;
  esac
}

# The Brewfile's entries as "<type> <name>", less the casks in $HOMEBREW_BUNDLE_CASK_SKIP.
entries() {
  local type name
  sed -nE 's/^[[:space:]]*(tap|brew|cask)[[:space:]]+"([^"]*)".*/\1 \2/p' "$1" |
    while read -r type name; do
      case "$type: ${HOMEBREW_BUNDLE_CASK_SKIP:-} " in
        cask:*" $name "*) ;;
        *) echo "$type $name" ;;
      esac
    done
}

installed() {
  awk -v t="$1" -v n="$2" '$1 == t && $2 == n { found = 1 } END { exit !found }' "$state/installed"
}

brewfile() {
  local arg
  for arg in "$@"; do
    case "$arg" in --file=*) echo "${arg#--file=}" ;; esac
  done
}

bundle_check() {
  local type name
  while read -r type name; do
    installed "$type" "$name" || exit 1
  done <<EOF_ENTRIES
$(entries "$(brewfile "$@")")
EOF_ENTRIES
  echo "The Brewfile's dependencies are satisfied."
}

# brew install --cask --adopt, as brew bundle always runs it.
install_cask() {
  local name=$1 app
  app=$(cask_app "$name")
  if [ -n "$app" ] && [ -e "$appdir/$app" ]; then
    echo "==> Adopting existing App at '$appdir/$app'"
    if [ "$(cat "$appdir/$app/version")" != "$version" ]; then
      echo "Error: It seems the existing App is different from the one being installed."
      return 1
    fi
  elif [ -n "$app" ]; then
    mkdir -p "$appdir/$app"
    echo "$version" >"$appdir/$app/version"
  fi
}

bundle_install() {
  local type name failures=0
  while read -r type name; do
    if installed "$type" "$name"; then
      echo "Using $name"
      continue
    fi
    echo "Installing $name"
    if grep -qxF "$name" "$state/broken"; then
      echo "Error: Download failed for $name"
    elif [ "$type" != cask ] || install_cask "$name"; then
      echo "$type $name $version" >>"$state/installed"
      continue
    fi
    echo "Installing $name has failed!" >&2
    failures=$((failures + 1))
  done <<EOF_ENTRIES
$(entries "$(brewfile "$@")")
EOF_ENTRIES
  if [ "$failures" -gt 0 ]; then
    echo "Homebrew Bundle failed! $failures Brewfile dependencies failed to install." >&2
    exit 1
  fi
  echo "Homebrew Bundle complete!"
}

# The parts of `brew info --cask` output that name the app.
info_cask() {
  local app
  app=$(cask_app "$1")
  echo "==> $1: $version"
  echo "Not installed"
  echo "==> Artifacts"
  if [ -n "$app" ]; then
    echo "$app (App)"
  else
    echo "$1 (Binary)"
  fi
}

case "$*" in
  --prefix) echo "${STUB_BREW_PREFIX:-/opt/homebrew}" ;;
  update) ;;
  "bundle check"*) bundle_check "$@" ;;
  "bundle install"*) bundle_install "$@" ;;
  "info --cask "*) info_cask "$3" ;;
  "list --formula --versions") awk '$1 == "brew" { print $2, $3 }' "$state/installed" ;;
  "list --cask --versions") awk '$1 == "cask" { print $2, $3 }' "$state/installed" ;;
  *)
    echo "stub brew: unsupported: brew $*" >&2
    exit 2
    ;;
esac
